# ─── Database (MySQL) ───────────────────────────────
# Single source of truth for the app, the seeder and the Prisma CLI.
# Percent-encode special characters in the user/password:
#   & → %26   * → %2A   # → %23   ! → %21   @ → %40   $ → %24   ^ → %5E   % → %25
# Example: password p4&Ks1  →  p4%26Ks1
DATABASE_URL="mysql://USER:PASSWORD@127.0.0.1:3306/paybanet"

# ─── Auth ───────────────────────────────────────────
# Generate with: openssl rand -base64 48
SESSION_SECRET=""
